# ==============================================
# Sakha Application Environment Configuration (Template)
# Copy this file to .env and fill in your values
# ==============================================

# ── LLM Configuration ──
# Options: 'groq' (default, ultra-fast), 'gemini' (Google AI), or 'mock' (heuristic)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gmail IMAP Settings ──
# Enter your Gmail address and 16-character Google App Password
# (Generate at: https://myaccount.google.com/security -> 2-Step Verification -> App Passwords)
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Gmail OAuth 2.0 Settings (Alternative) ──
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ── Vector Database & Local RAG Embeddings ──
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Server & Network Settings ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Logging Configuration ──
LOG_LEVEL=INFO
LOG_FILE=app.log
