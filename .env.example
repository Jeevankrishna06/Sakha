# ==============================================
# Sakha Application Environment Configuration
# ==============================================

# ── LLM Configuration ──
# Options: 'groq' (default, ultra-fast), 'gemini' (Google AI), or 'mock' (heuristic fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── User Profile / Sender Settings ──
USER_NAME=Your Name

# ── Gmail Authentication Option A: IMAP + App Password (Quickest Setup) ──
# Generate at: https://myaccount.google.com/security -> 2-Step Verification -> App Passwords
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Gmail Authentication Option B: OAuth 2.0 (Google Cloud Project) ──
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ── Google Cloud Pub/Sub (Optional: Real-Time Webhook Push) ──
GMAIL_PUBSUB_TOPIC=

# ── Vector Database & Local RAG Embeddings ──
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── Server & Network Settings ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Logging Configuration ──
LOG_LEVEL=INFO
LOG_FILE=app.log
